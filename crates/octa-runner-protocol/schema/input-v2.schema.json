{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OctaHive/octa/main/crates/octa-runner-protocol/schema/input-v2.schema.json",
  "title": "Octa runner input protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/start" },
    { "$ref": "#/$defs/cancel" }
  ],
  "$defs": {
    "start": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "request"],
      "properties": {
        "type": { "const": "start" },
        "protocol_version": { "const": 2 },
        "request_id": { "type": "string", "minLength": 1 },
        "request": { "$ref": "#/$defs/request" }
      },
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "required": ["type", "request_id"],
      "properties": {
        "type": { "const": "cancel" },
        "request_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["workspace", "commands"],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "octafile": { "type": ["string", "null"] },
        "data_dir": { "type": "string" },
        "plugins_dir": { "type": "string" },
        "plugin_lock": { "type": ["string", "null"] },
        "secrets_profile": { "type": ["string", "null"] },
        "cache": {
          "oneOf": [
            { "$ref": "#/$defs/cache_session" },
            { "type": "null" }
          ]
        },
        "plugins": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "default_plugin": { "type": ["string", "null"] },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "concurrency": { "type": ["integer", "null"], "minimum": 1 },
        "parallel": { "type": "boolean" },
        "failfast": { "type": "boolean" },
        "dry": { "type": "boolean" },
        "force": { "type": "boolean" },
        "quiet": { "type": "boolean" },
        "silence": {
          "oneOf": [
            { "type": "boolean" },
            { "enum": ["stdout", "stderr"] },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "hash", "size_bytes"],
      "properties": {
        "algorithm": { "enum": ["blake3", "sha256"] },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "os", "architecture", "environment"],
          "properties": {
            "kind": { "const": "native" },
            "os": { "enum": ["linux", "windows", "macos"] },
            "architecture": { "enum": ["amd64", "arm64"] },
            "environment": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "os", "architecture", "image"],
          "properties": {
            "kind": { "const": "oci" },
            "os": { "enum": ["linux", "windows"] },
            "architecture": { "enum": ["amd64", "arm64"] },
            "image": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        }
      ]
    },
    "remote_cache": {
      "type": "object",
      "required": ["endpoint", "token_file", "request_timeout_seconds", "max_parallel_transfers"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https://" },
        "token_file": { "type": "string", "minLength": 1 },
        "request_timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_parallel_transfers": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "cache_session": {
      "type": "object",
      "required": ["mode", "namespace", "local_directory", "runtime"],
      "properties": {
        "mode": { "enum": ["read_only", "write_only", "read_write"] },
        "namespace": { "type": "string", "minLength": 1 },
        "local_directory": { "type": "string", "minLength": 1 },
        "runtime": { "$ref": "#/$defs/runtime" },
        "remote": {
          "oneOf": [
            { "$ref": "#/$defs/remote_cache" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
